	all_weapons[all_weapons.size() - 1].icon = "⚔️"
	
	all_weapons.append(WeaponCard.new("匕首", "快速攻击，但伤害较低", WeaponCard.WeaponType.MELEE, 
		WeaponCard.AttackPattern.MULTI, WeaponCard.SpecialEffect.BLEED))
	all_weapons[all_weapons.size() - 1].damage_modifier = 0.8
