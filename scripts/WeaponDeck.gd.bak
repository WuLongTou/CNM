	all_weapons[all_weapons.size() - 1].special_value = 30.0
	all_weapons[all_weapons.size() - 1].health_modifier = -50
	all_weapons[all_weapons.size() - 1].icon = "🧛"
	
	all_weapons.append(WeaponCard.new("狂暴药剂", "大幅提升攻击，降低防御", WeaponCard.WeaponType.SUPPORT, 
		WeaponCard.AttackPattern.SINGLE, WeaponCard.SpecialEffect.BLEED))
	all_weapons[all_weapons.size() - 1].damage_modifier = 1.8
	all_weapons[all_weapons.size() - 1].health_modifier = -40
	all_weapons[all_weapons.size() - 1].special_value = 3.0
	all_weapons[all_weapons.size() - 1].icon = "💊"
	
	# 传说武器
	all_weapons.append(WeaponCard.new("长枪", "超长范围，可穿透敌人", WeaponCard.WeaponType.MELEE, 
		WeaponCard.AttackPattern.SPREAD, WeaponCard.SpecialEffect.NONE))
	all_weapons[all_weapons.size() - 1].damage_modifier = 1.4
	all_weapons[all_weapons.size() - 1].range_modifier = 2.0
	all_weapons[all_weapons.size() - 1].attack_speed_modifier = 0.8
	all_weapons[all_weapons.size() - 1].tags = ["战斧"]
	all_weapons[all_weapons.size() - 1].icon = "🔱"
	
	all_weapons.append(WeaponCard.new("死神镰刀", "收割生命，范围伤害", WeaponCard.WeaponType.MELEE, 
		WeaponCard.AttackPattern.SPREAD, WeaponCard.SpecialEffect.LIFE_STEAL))
	all_weapons[all_weapons.size() - 1].damage_modifier = 2.0
	all_weapons[all_weapons.size() - 1].attack_speed_modifier = 0.6
	all_weapons[all_weapons.size() - 1].special_value = 25.0
	all_weapons[all_weapons.size() - 1].health_cost = 5
	all_weapons[all_weapons.size() - 1].tags = ["巨剑", "战斧"]
	all_weapons[all_weapons.size() - 1].icon = "⚰️"
	
	all_weapons.append(WeaponCard.new("神圣之剑", "净化邪恶，高额伤害", WeaponCard.WeaponType.MELEE, 
		WeaponCard.AttackPattern.CHARGE, WeaponCard.SpecialEffect.NONE))
	all_weapons[all_weapons.size() - 1].damage_modifier = 2.2
	all_weapons[all_weapons.size() - 1].cooldown = 2.5
	all_weapons[all_weapons.size() - 1].health_cost = 10
	all_weapons[all_weapons.size() - 1].tags = ["双刀", "匕首"]
	all_weapons[all_weapons.size() - 1].icon = "✨"
	
	all_weapons.append(WeaponCard.new("时间法师", "控制时间，减缓敌人", WeaponCard.WeaponType.MAGIC, 
		WeaponCard.AttackPattern.SINGLE, WeaponCard.SpecialEffect.SLOW))
	all_weapons[all_weapons.size() - 1].damage_modifier = 1.0
	all_weapons[all_weapons.size() - 1].special_value = 5.0
	all_weapons[all_weapons.size() - 1].health_modifier = -30
	all_weapons[all_weapons.size() - 1].tags = ["冰霜法杖", "雷电法杖"]
	all_weapons[all_weapons.size() - 1].icon = "⏳"
	
	# 设置稀有度
	var basic_count = 0
	var advanced_count = 0
	var legendary_count = 0
	
	for weapon in all_weapons:
		if weapon.tags.is_empty() and weapon.card_name != "狂暴药剂":
			weapon.rarity = 1
			basic_count += 1
		elif "火球法杖" in weapon.tags or "战斧" in weapon.tags or "连弩" in weapon.tags or "双刀" in weapon.tags:
			weapon.rarity = 2
			advanced_count += 1
		else:
			weapon.rarity = 3
			legendary_count += 1
	
	print("武器库初始化完成: 基础" + str(basic_count) + "个, 进阶" + str(advanced_count) + "个, 传说" + str(legendary_count) + "个")

func draw_three_cards(player: Player = null) -> Array[WeaponCard]:
	var pool: Array[WeaponCard] = []
	
	if player == null:
		pool = all_weapons.duplicate()
	else:
		var inventory_names: Array[String] = []
		for w in player.active_effects:
			inventory_names.append(w.card_name)
		
		# 第一阶段：添加基础武器（如果没有拥有）
		for w in all_weapons:
			if w.rarity == 1 and not inventory_names.has(w.card_name):
				pool.append(w)
		
		# 第二阶段：添加升级选项（如果有前置武器）
		for w in all_weapons:
			if w.rarity == 2 and prerequisites.has(w.card_name):
				var required = prerequisites[w.card_name]
				if inventory_names.has(required):
					pool.append(w)
					pool.append(w)  # 双倍权重
		
		# 第三阶段：添加传说武器（如果有对应进阶武器）
		for w in all_weapons:
			if w.rarity == 3:
				for tag in w.tags:
					if inventory_names.has(tag):
						pool.append(w)
						break
		
		# 第四阶段：根据玩家风格添加协同武器
		for w in all_weapons:
			if w.is_upgrade_for(inventory_names):
				if w not in pool:
					pool.append(w)
		
		# 第五阶段：偶尔添加负面效果选项（平衡性）
		if randf() < 0.3:
			var negative_weapons = []
			for w in all_weapons:
				if w.is_negative():
					negative_weapons.append(w)
			if negative_weapons.size() > 0:
				var neg = negative_weapons.pick_random()
				pool.append(neg)
	
	if pool.is_empty():
		pool = all_weapons.duplicate()
	
	pool.shuffle()
	
	var drawn_cards: Array[WeaponCard] = []
	var selected_names: Array[String] = []
	
	for card in pool:
		if drawn_cards.size() >= 3:
			break
		
		if not selected_names.has(card.card_name):
			drawn_cards.append(card)
			selected_names.append(card.card_name)
	
	if drawn_cards.size() < 3:
		var backup_pool = all_weapons.duplicate()
		backup_pool.shuffle()
		for card in backup_pool:
			if drawn_cards.size() >= 3:
				break
			if not selected_names.has(card.card_name):
				drawn_cards.append(card)
				selected_names.append(card.card_name)
	
	return drawn_cards

func get_random_weapon() -> WeaponCard:
	if all_weapons.size() == 0:
		return null
	return all_weapons.pick_random()
