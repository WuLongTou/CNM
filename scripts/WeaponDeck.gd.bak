	all_weapons[all_weapons.size() - 1].ammo_cost = 5
	all_weapons[all_weapons.size() - 1].tags = ["弓箭"]
	all_weapons[all_weapons.size() - 1].icon = "🔫"
	
	all_weapons.append(WeaponCard.new("狙击弩", "超高伤害，远射程", WeaponCard.WeaponType.RANGED, 
		WeaponCard.AttackPattern.CHARGE, WeaponCard.SpecialEffect.NONE))
	all_weapons[all_weapons.size() - 1].damage_modifier = 2.5
	all_weapons[all_weapons.size() - 1].attack_speed_modifier = 0.4
	all_weapons[all_weapons.size() - 1].ammo_cost = 2
	all_weapons[all_weapons.size() - 1].cooldown = 3.0
	all_weapons[all_weapons.size() - 1].tags = ["连弩", "弓箭"]
	all_weapons[all_weapons.size() - 1].icon = "🎯"
	
	# 魔法武器 - 进阶
	all_weapons.append(WeaponCard.new("火球法杖", "发射火球，爆炸伤害", WeaponCard.WeaponType.MAGIC, 
		WeaponCard.AttackPattern.SINGLE, WeaponCard.SpecialEffect.EXPLOSION))
	all_weapons[all_weapons.size() - 1].damage_modifier = 1.3
	all_weapons[all_weapons.size() - 1].special_value = 3.0
	all_weapons[all_weapons.size() - 1].ammo_cost = 2
	all_weapons[all_weapons.size() - 1].tags = ["法杖"]
	all_weapons[all_weapons.size() - 1].icon = "🔥"
	
	all_weapons.append(WeaponCard.new("冰霜法杖", "冰冻敌人，减速控制", WeaponCard.WeaponType.MAGIC, 
