	all_weapons.append(WeaponCard.new("双刀", "双持武器，攻击速度快", WeaponCard.WeaponType.MELEE, 
		WeaponCard.AttackPattern.MULTI, WeaponCard.SpecialEffect.LIFE_STEAL))
	all_weapons[all_weapons.size() - 1].damage_modifier = 0.8
	all_weapons[all_weapons.size() - 1].attack_speed_modifier = 1.5
	all_weapons[all_weapons.size() - 1].special_value = 10.0
	all_weapons[all_weapons.size() - 1].health_modifier = -20
	all_weapons[all_weapons.size() - 1].tags = ["铁剑"]
	all_weapons[all_weapons.size() - 1].icon = "🔪"
	
	# 远程武器 - 进阶
	all_weapons.append(WeaponCard.new("连弩", "连发武器，高射速", WeaponCard.WeaponType.RANGED, 
		WeaponCard.AttackPattern.MULTI, WeaponCard.SpecialEffect.NONE))
	all_weapons[all_weapons.size() - 1].damage_modifier = 0.7
	all_weapons[all_weapons.size() - 1].ammo_cost = 3
	all_weapons[all_weapons.size() - 1].tags = ["弓箭"]
	all_weapons[all_weapons.size() - 1].icon = "🎯"
	
	all_weapons.append(WeaponCard.new("散弹枪", "扇形攻击，范围伤害", WeaponCard.WeaponType.RANGED, 
		WeaponCard.AttackPattern.SPREAD, WeaponCard.SpecialEffect.NONE))
