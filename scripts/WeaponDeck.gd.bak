class_name WeaponDeck
extends Node

var all_weapons: Array[WeaponCard] = []
var prerequisites: Dictionary = {}

func _ready():
	_initialize_weapon_deck()
	_setup_prerequisites()

func _setup_prerequisites():
	prerequisites = {
		"战斧": "铁剑",
		"双刀": "铁剑",
		"长枪": "战斧",
		"巨剑": "战斧",
		"连弩": "弓箭",
		"狙击弩": "连弩",
		"散弹枪": "弓箭",
		"火球法杖": "法杖",
		"冰霜法杖": "火球法杖",
		"雷电法杖": "火球法杖",
		"死神镰刀": "巨剑",
		"神圣之剑": "双刀",
	}

func _initialize_weapon_deck():
	# 近战武器 - 基础
