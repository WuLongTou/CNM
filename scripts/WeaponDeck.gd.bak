		WeaponCard.AttackPattern.CHARGE, WeaponCard.SpecialEffect.EXPLOSION))
	all_weapons[all_weapons.size() - 1].damage_modifier = 1.5
	all_weapons[all_weapons.size() - 1].attack_speed_modifier = 0.7
