		WeaponCard.AttackPattern.SPREAD, WeaponCard.SpecialEffect.CHAIN))
	all_weapons[all_weapons.size() - 1].damage_modifier = 1.2
	all_weapons[all_weapons.size() - 1].ammo_cost = 3
	all_weapons[all_weapons.size() - 1].tags = ["火球法杖"]
	all_weapons[all_weapons.size() - 1].icon = "⚡"
	
	# 辅助装备 - 进阶
	all_weapons.append(WeaponCard.new("吸血鬼之血", "大幅提升吸血效果", WeaponCard.WeaponType.SUPPORT, 
