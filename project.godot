",
"C# Class (Node2D)": "# ${NAME}.cs — ${DATE} ${TIME}

using Godot;
using System;

public partial class ${NAME} : Node2D
{
	// Node references
	// [Export] private Sprite2D _sprite;

	// Signals
	// [Signal] public delegate void MySignalEventHandler(object sender, int value);

	public override void _Ready()
	{
		// GD.Print(\"${NAME} ready\");
	}

	public override void _Process(double delta)
	{
	}

	public override void _PhysicsProcess(double delta)
	{
	}
}
",
"C# Singletons.Manager": "# ${NAME}.cs — ${DATE} ${TIME}

using Godot;
using System;

/// <summary>
/// Singleton manager for ${DESC}.
/// Access via: ${NAME}.Instance
/// </summary>
public partial class ${NAME} : Node
{
	public static ${NAME}? Instance { get; private set; }

	public override void _EnterTree()
	{
		if (Instance != null && Instance != this)
		{
			QueueFree();
			return;
		}
		Instance = this;
	}

	public override void _ExitTree()
	{
		if (Instance == this)
			Instance = null;
	}

	public override void _Ready()
	{
		GD.Print(\"[${NAME}] Initialized\");
	}
}
",
"C# Static Class": "# ${NAME}.cs — ${DATE} ${TIME}

using Godot;
using System;

public static class ${NAME}
{
	private static bool _initialized = false;

	public static void Initialize()
	{
		if (_initialized) return;
		_initialized = true;
	}
}
",
"Empty C# Script": "# ${NAME}.cs — ${DATE} ${TIME}

using Godot;
using System;

public partial class ${NAME} : ${BASE}
{
	// Called when the node enters the scene tree for the first time.
	public override void _Ready()
	{
	}

	// Called every frame. 'delta' is the elapsed time since the previous frame.
	public override void _Process(double delta)
	{
	}
}
"
}

